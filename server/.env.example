# --- FRG Fight Club server config — copy to .env and fill in -------------
# NEVER commit the real .env. The treasury mnemonic is a private key:
# anyone who has it can drain the treasury wallet.

PORT=8787

# Terra Classic LCD (public endpoint; swap for your own node if you have one)
LCD_URL=https://terra-classic-lcd.publicnode.com
CHAIN_ID=columbus-5

# FRG CW20 contract (verified on-chain: "FRG Universe", decimals 6)
FRG_CONTRACT=terra14rfnhc2aru7jp304lht3yf903necsnrt4cxd464cftsfcksw0rtsgundnt

# Game economy — must match the client's displayed numbers
ENTRY_FEE_FRG=10
PRIZE_FRG=18

# Treasury wallet ("the bank"): create it in Station / Keplr / LuncDash.
# Fund it with LUNC for gas + FRG for prizes. Keep only what the game needs
# in it — treat it as a hot wallet.
TREASURY_ADDRESS=terra1REPLACE_WITH_YOUR_TREASURY_ADDRESS
TREASURY_MNEMONIC=word1 word2 word3 ... (24 words, server only)

# Your Telegram bot token from @BotFather. Optional but recommended:
# when set, the server verifies Telegram Mini App initData on entry,
# so sessions can only be created from inside your bot's Mini App.
BOT_TOKEN=
